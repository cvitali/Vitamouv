@{
    ViewData["Title"] = "Ouvertures de bals de mariages";
}

<div>
    <div class="heroEvent displayEVent container-fluid">
        <h1 class="heroEvent__title">Faites de votre ouverture de bal un moment unique et inoubliable !</h1>
        <div class="row row-cols-3">
            <div class="col">
                <img class="heroEvent__img img-fluid" src="~/assets/images/couple.png" alt="Couple" />
            </div>
            <div class="col">
                <img class="heroEvent__img img-fluid" src="~/assets/images/couple3.png" alt="Couple" />
            </div>
            <div class="col">
                <img class="heroEvent__img img-fluid" src="~/assets/images/couple2.png" alt="Couple" />
            </div>
        </div>
    </div>
    <div class="descriptionEvent descriptionEvent__wedding displayEVent container-fluid mt-5 mb-5">
        <div class="descriptionEvent__text textWedding">
 
            <p class="textWedding">
                Que vous soyez danseurs expérimentés ou débutants,
                <br />
                je vous propose des chorégraphies sur-mesure adaptée à votre style
                <br />
                afin que ce moment soit à la hauteur de vos attentes.
                <br />
                <br />
                De la valse traditionnelle à la plus folle des chorégraphies 
                <br />
                je crée une performance qui vous ressemble !
                <br/>
                <br/>
                La prestation inclus:
                <ul>
                    <li>Une consultation initiale pour cerner vos envies et attentes.</li>
                    <li>La création d'une chorégraphie sur mesure, adaptée à votre style et à vos goûts musicaux.</li>
                    <li>Le montage audio de votre musique.</li>
                    <li>7 répétitions d'1 heure pour maîtriser chaque mouvement en toute sérénité.</li>
                    <li>1 répétition générale (idéalement sur place, selon disponibilité).</li>
                    <li>Un contact direct avec votre DJ pour la mise en place technique et musicale.</li>
                </ul>
                <br />
                <br />   
            </p>
            <img class="iconeMariés" src="~/assets/images/mariés.png" />
            <div class="contact contactEVents">
                <p>Le tarif varie en fonction du lieu de déplacement et des besoins particuliers.</p>
                <h5 class="mb-3">N'hésitez pas à me contacter pour un devis personnalisé:</h5>
                <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                    <div class="btn btn-outline-burgundy btnEvent">
                        Prendre contact
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")

    </div>
</div>
@{
    ViewData["Title"] = "Danse'MOUV";
}

<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lighterGreen">
            <section class="mb-5 d-flex justify-content-center m-lg-5">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background">
                        <img class="presentation__img img-fluid" src="~/assets/images/dansemouv.png" alt="danseurs" />
                        <div class="presentation__text container-fluid border-green">
                            <h2>Danse’MOUV</h2>
                            <h3>Donnez vie à vos mouvements</h3>
                        </div>
                    </div>
                </div>
            </section>
            <section class="activity bg-lightGreenGradient text-medium">
                <h3 class="activity__title">Danse'MOUV</h3>
                <p class="activity__description">
                    Danse’MOUV accompagne les clubs, associations sportives et structures culturelles dans la conception et le développement de chorégraphies adaptées à leurs projets, qu’ils soient compétitifs ou non.
                    <br />
                    Forte de plusieurs années de pratique dans différents styles de danse et d’une solide expérience en création chorégraphique dans le milieu gymnique, je propose un accompagnement sur mesure, en cohérence avec votre  discipline, votre niveau et vos objectifs sportifs ou artistiques. 
                    <br />
                    Cette double expertise me permet d’associer la danse à la préparation gymnique, en intégrant harmonieusement technique, expression et exigences physiques propres à chaque discipline.
                    <br />
                    <br />
                    Danse’MOUV intervient pour la création d’enchaînements individuels, de chorégraphies de groupe, ainsi que pour le travail de la présence scénique, de l’expression corporelle et de la mise en valeur du mouvement, tout en tenant compte des bases techniques et des capacités gymniques des pratiquants.
                    <br />
                    <br />
                    À l’écoute des besoins de chaque structure, je m’adapte à vos  contraintes d’entraînement, de calendrier et de compétition. 
                    <br />
                    Les  interventions peuvent être ponctuelles (création spécifique, préparation d’un événement ou d’une compétition) ou s’inscrire dans un accompagnement régulier au sein de votre club ou association.
                    <br />
                    <br />
                    Danse’MOUV, c’est une approche créative, structurée et bienveillante, au service de la performance, de l’expression artistique et de l’identité de votre club.
                    <br />
                    <br />
                    Je serais ravie de vous présenter mon concept et de répondre à toutes vos questions lors d’un rendez-vous téléphonique ou dans vos locaux.
                </p>
                <h6 class="mt-3 fw-bold">N'hésitez pas à me contacter pour un devis personnalisé:</h6>
                <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                    <div class="btn btn-outline-burgundy mt-3">
                        Prendre contact
                    </div>
                </a>
            </section>
        </div>
        <div class="clickableLogoActivity">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
    </div>
</div>

@{
    ViewData["Title"] = "Slow'MOUV";
    ViewData["Description"] = "Gym douce tout public, adaptée aux femmes enceintes et aux séniors. Mouvements doux, cardio progressif et renforcement des muscles locomoteurs pour retrouver mobilité, confiance et bien‑être. Interventions clés en main pour collectivités, EHPAD, résidences séniors et structures périnatales ou médico‑sociales en Moselle (57) et au Luxembourg. ";
}

<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lighterPurple">
            <section class="mb-5 d-flex justify-content-center">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background bg-slowmouv">                       
                        <div class="presentation__text container-fluid border-purple">
                            <h2>Slow’MOUV</h2>
                            <p> Bouger autrement, en douceur et avec plaisir</p>
                        </div>
                    </div>
                 </div>
            </section>
            <section class="activity bg-lightPurpleGradient text-medium">                
                <p class="activity__description">
                    Les séances <strong>Slow’MOUV </strong> sont conçues pour s’adapter à chaque pratiquant,  quel que soit son âge ou sa condition physique.
                    <br />
                    Grâce à mes formations  spécialisées en sport santé, gym seniors et périnatalité, je propose un accompagnement personnalisé, sécurisé et bienveillant.
                    <br/>
                    Chaque séance associe mouvements doux, travail cardio progressif et renforcement des muscles locomoteurs afin d'améliorer la mobilité, l’équilibre et le bien-être au quotidien.
                    <br />
                    <br />
                    Slow’MOUV, c’est aussi un moment de partage et de bonne humeur favorisant la confiance en soi et le lien social.
                    <br />
                    Les séances peuvent être organisées en association, EHPAD, résidence seniors ou centre de périnatalité, en petits groupes ou en séances adaptées aux besoins de votre structure.
                    <br />
                    <br />
                    Je serais ravie de vous présenter mon concept et de répondre à toutes vos questions lors d’un rendez-vous téléphonique ou dans vos locaux.
                </p>
                <h6 class="mt-3 fw-bold">N'hésitez pas à me contacter pour un devis personnalisé:</h6>
                <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                    <div class="btn btn-outline-burgundy mt-3">
                        Prendre contact
                    </div>
                </a>
            </section>
        </div>
        <div class="clickableLogoActivity">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
    </div>
    <img class="mx-auto d-block pointer arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />
</div>

@{
    ViewData["Title"] = "Event'MOUV";
    ViewData["Description"] = "Création de spectacles et d'animations sur mesure pour événements publics, ouvertures de bal et anniversaires d’enfants. Une approche créative, professionnelle et bienveillante pour des moments uniques qui marquent les esprits. Interventions en Moselle (57) et au Luxembourg.";
}

<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lighterPink">
            <section class="mb-5 d-flex justify-content-center">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background bg-eventmouv">
                        <div class="presentation__text container-fluid border-pink">
                            <h2>Event’MOUV</h2>
                            <p>Donnez vie à vos événements</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="activity__eventmouv bg-lightPinkGradient text-medium" id="eventmouvAncre">
                <p class="activity__description p-5 text-center">
                    Que ce soit pour un événement publique, une ouverture de bal de mariage ou un anniversaire d’enfant, Event’MOUV vous propose une approche créative, professionnelle et bienveillante, au service d’événements uniques, pensés pour marquer les esprits.
                </p>
                <div class="container-fluid my-5" >
                    <div class="row row-cols-1 row-cols-md-3 g-1 g-lg-3 gy-5">
                        <div class="col">
                            <a class="event pointer event-js" asp-area="" asp-controller="Events" asp-action="EventsCreation">
                                <img class="img-fluid event__image" src="~/assets/images/creationEvent.png" alt="création d'événements"/>
                                <p class="event__title">Création d'événements</p>
                                <p class="event__title hidden-js hiddenText-js">En savoir plus...</p>
                            </a>
                        </div>
                        <div class="col">
                            <a class="event pointer event-js" asp-area="" asp-controller="Events" asp-action="Wedding">
                                <img class="img-fluid event__image" src="~/assets/images/couple.png" alt="ouverture de bal de mariage" />
                                <p class="event__title">Ouverture de bal de mariage</p>
                                <p class="event__title hidden-js hiddenText-js">En savoir plus...</p>
                            </a>
                        </div>
                        <div class="col">
                            <a class="event pointer event-js" asp-area="" asp-controller="Events" asp-action="Birthday">
                                <img class="img-fluid event__image" src="~/assets/images/anniversaire.png" alt="anniversaire" />
                                <p class="event__title">Anniversaire sportif</p>
                                <p class="event__title hidden-js hiddenText-js">En savoir plus...</p>
                            </a>
                        </div>
                    </div>
                </div>
                <h6 class="my-3 fw-bold ps-2 ps-md-5 pe-5">N'hésitez pas à me contacter pour un devis personnalisé:</h6>
                <div class="btn btn-outline-burgundy ms-2 ms-md-5 mb-5 js-contactBtn">
                    Prendre contact
                </div>
            </section>
        </div>
        <div class="clickableLogoActivity">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
    </div>
    <img class="mx-auto d-block pointer arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />
</div>



@{
    ViewData["Title"] = "School'MOUV";
    ViewData["Description"] = "Gymnastique rythmique pour enfants dès 6 ans : coordination, expression et travail avec engins. Interventions clés en main pour écoles et collectivités en Moselle (57) et au Luxembourg.";
}


<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lightYellow">
            <section class="mb-5 d-flex justify-content-center">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background bg-schoolmouv">
                        <div class="presentation__text container-fluid border-yellow">
                            <h2>School’MOUV</h2>
                            <p>Grandir et s’épanouir par le mouvement</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="activity bg-lightYellowGradient text-medium">
                <p class="activity__description">
                    Les séances de gymnastique rythmique <strong>School'MOUV</strong> sont dédiées aux enfants à partir de 6 ans.
                    <br/>
                    Ce sont des presrations structurées et stimulantes avec des objectifs évoluant selon l’âge du pratiquant.
                    <br/>
                    La création d’enchaînements en musique et l’utilisation des engins (cerceaux, ballons, massues et rubans) aident à développer chez l’enfant et l’adolescent la coordination motrice, la créativité, la mémoire, l’esprit d’équipe, la souplesse, la confiance en soi.
                    <br/>
                    <br/>
                    Je m'adapte à votre établissement et à vos besoins.
                </p>
                <h6 class="my-3 fw-bold">N'hésitez pas à me contacter pour un devis personnalisé:</h6>
                <div class="btn btn-outline-burgundy js-contactBtn">
                    Prendre contact
                </div>
            </section>
        </div>
        <div class="clickableLogoActivity">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
    </div>
    <img class="mx-auto d-block pointer arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />
</div>
@{
    ViewData["Title"] = "School'MOUV";
}

<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lightYellow">
            <section class="mb-5 d-flex justify-content-center m-lg-5">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background">
                        <img class="presentation__img img-fluid" src="~/assets/images/schoolmouv.png" alt="gym enfants" />
                        <div class="presentation__text container-fluid">
                            <h2>School’MOUV</h2>
                            <h3>Grandir et s’épanouir par le mouvement</h3>
                        </div>
                    </div>
                </div>
            </section>
            <section class="activity bg-lightYellowGradient">
                <h3 class="activity__title">School'MOUV</h3>
                <p class="activity__description">
                    Les séances de gymnastique rythmique “SCHOOL’MOUV” sont dédiées aux enfants à partir de 6 ans.
                    <br/>
                    Ce sont des presrations structurées et stimulantes avec des objectifs évoluant selon l’âge du pratiquant.
                    <br/>
                    La création d’enchaînements en musique et l’utilisation des engins (cerceaux, ballonx, massues et rubans) aident à développer chez l’enfant et l’adolescent la coordination motrice, la créativité, la mémoire, l’esprit d’équipe, la souplesse, la confiance en soi.
                    <br/>
                    <br/>
                    Je m'adapte à votre établissement et à vos besoins.
                </p>
                <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                    <div class="btn btn-outline-burgundy">
                        Prendre contact
                    </div>
                </a>
            </section>
        </div>
        <div class="importedClickableLogo">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
        <div class="contact">
            <h5 class="mb-3">N'hésitez pas à me contacter pour un devis personnalisé:</h5>
            <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                <div class="btn btn-outline-burgundy">
                    Prendre contact
                </div>
            </a>
        </div>
    </div>
</div>
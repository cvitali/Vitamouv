@{
    ViewData["Title"] = "Mini'MOUV";
    ViewData["Description"] = "Cours de Baby Gym ludiques et bienveillants pour stimuler le développement moteur et le bien-être des enfants de 6 mois à 5 ans. Interventions clés en main pour crèches, écoles et collectivités en Moselle (57) et au Luxembourg.";
}

<div class="container w-100">
    <div class="main__activity">
        <div class="main__background bg-lighterBlue">
            <section class="mb-5 d-flex justify-content-center">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background bg-minimouv">
                        <div class="presentation__text container-fluid border-blue">
                            <h2 class="colorBlue">Mini’MOUV</h2>
                            <p>Le mouvement au coeur de l’éveil</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="activity bg-lightBlueGradient text-medium">
                <p class="activity__description">
                    <strong>Mini'MOUV</strong> est un concept de Baby Gym ludique et bienveillant, pensé pour stimuler le développement moteur et le bien-être des enfants de 6 mois à 5 ans.
                    <br />
                    Avec Mini'MOUV je vous propose:
                    <ul class="list">
                        <li>Des activités structurées et stimulantes, adaptées à chaque âge et chaque enfant. </li>
                        <li>Des séances de 45mn à 1h00 respectant leur rythme et leur sécurité.</li>
                        <li>Une prestation clé en main incluant l'installation et le rangement du matériel</li>
                        <li>Je me déplace avec mon matériel personnel et utilise également celui disponible sur place</li>
                    </ul>
                    <br/>
                    Mini’MOUV transforme le temps d’activité physique en moment de jeu et de découverte tout en accompagnant les professionnels dans la mise en place d’activités adaptées.
                    <br/>
                    Je serais ravie de vous présenter mon concept et de répondre à toutes vos questions lors d’un rendez-vous téléphonique ou dans vos locaux.
                </p>
                <h6 class="mt-3 fw-bold">N'hésitez pas à me contacter pour un devis personnalisé:</h6>
                <a class="contactBtn" href="mailto:nelly.vitali.57@gmail.com">
                    <div class="btn btn-outline-burgundy mt-3">
                        Prendre contact
                    </div>
                </a>
            </section>   
        </div>
        <div class="clickableLogoActivity">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
    </div>
    <div class="socialNetworksandContact socialNetworksandContact__activity">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
    </div>
    <img class="mx-auto d-block pointer arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VITA'MOUV'</title>
    <meta name="description" content="Cours de gym, Création de spectacles, Organisation d'événements: anniversaires sportifs, ouvertures de bals de mariages..." />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vitamouv.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clickableLogo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/socialNetworks&Contact.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activity.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="logo container-fluid" id="topPage">
            <img class="logo__draw" src="~/assets/images/logoFullBlack.svg" />   
        </div>
        <nav class="navbar navbar-dark navbar-expand-sm navbar-toggleable-sm ">
            <div class="container-fluid bg-burgundy">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img clas="navbar-brand__img" src="~/assets/images/silhouetteBlanc.png" alt="Vita'Mouv" height="24"/>
                </a>
                <button class="navbar-toggler me-4" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon "></span>
                </button>
                <div class="full-width navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="About">A propos</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-white dropdown-toggle" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Prestations
                            </a>
                            <div class="dropdown-menu bg-burgundy" aria-labelledby="navbarDropdownMenuLink">
                                <a class="dropdown-item" asp-area="" asp-controller="Activities" asp-action="Minimouv">Mini'MOUV:<br/>-gym de 6 mois à 5 ans</a>
                                <a class="dropdown-item" asp-area="" asp-controller="Activities" asp-action="Schoolmouv">School'MOUV:<br/>-gym enfants, à partir de 6 ans</a>
                                <a class="dropdown-item" asp-area="" asp-controller="Activities" asp-action="Slowmouv">Slow'MOUV:<br/>-gym douce, sport santé et périnatalité</a>
                                <a class="dropdown-item" asp-area="" asp-controller="Activities" asp-action="Dansemouv">Danse'MOUV:<br/>-chorégraphies, enchainements, expression corporelle</a>
                                <a class="dropdown-item" asp-area="" asp-controller="Activities" asp-action="Eventmouv">Event'MOUV:<br/>-création de spectacles, ouvertures de bals, anniversaires sportifs</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer container-fluid text-center">
        <div class="bg-burgundy">
            <div class="footer__contact row row row-cols-3 row-cols-lg-4">
                <div class="footer__contactDetail pointer col-4 col-md-3">
                    <a class="footer__contactDetailLink text-white" href="https://www.google.com/maps/place/Distroff" target="_blank">
                        <img class="img-fluid footer__img" src="~/assets/icones/icons8-adresse-50.png" alt="localisation" />
                        57925 Distroff
                    </a>
                </div>
                <div class="footer__contactDetail border-start border-white border-2 col-4 col-lg-3">
                    <img class="img-fluid footer__img" src="~/assets/icones/icons8-téléphone-50.png" alt="téléphone" />
                    06 64 81 68 69
                </div>
                <div class="footer__contactDetail pointer border-start border-white border-2 col-4 col-lg-3">
                    <a class="footer__contactDetailLink text-white" href="https://m.me/61554690836059" target="_blank">
                        <img class="img-fluid footer__img" src="~/assets/icones/icons8-facebook-messenger-48.png" alt="facebook messenger" />
                        Vita'MOUV
                    </a>
                </div>
                <div class="footer__contactDetail pointer border-start border-white border-2 col-12 col-4 col-lg-3">
                    <a class="footer__contactDetailLink text-white" href="mailto:nelly.vitali.57@gmail.com">
                        <img class="img-fluid footer__img" src="~/assets/icones/icons8-email-50.png" alt="adresse email" />
                        nelly.vitali.57@gmail.com
                    </a>
                </div>
            </div>
            <div class="footer__info">
                &copy; 2025 - Vita'MOUV - <a class="text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Mentions légales</a>
                <p>
                    Icônes par <a class="text-white" href="https://icons8.com">Icons8</a>
                    <br />
                    Photos par <a class="text-white" href="https://unsplash.com">Unsplash</a>, <a class="text-white" href="https://www.pexels.com">Pexels</a>, <a class="text-white" href="https://fr.freepik.com/">Freepik</a>
                    <br />
                    Site Web par
                    <a class="text-white" href="mailto:corinne.wilwert@yahoo.fr">
                        Corinne VITALI
                    </a>
                </p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

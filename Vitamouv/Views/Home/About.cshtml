@{
    ViewData["Title"] = "A propos";
}

<div class="container w-100">
    <div class="main__about">
        <div class="main__backgroundAbout">
            <section class="mb-5 d-flex justify-content-center">
                <div class="presentation presentation__activity container-fluid text-center">
                    <div class="presentation__background bg-about">
                        <div class="presentation__text container-fluid border-gray">
                            <h2>A propos de Vita’MOUV...</h2>
                        </div>
                    </div>
                </div>
            </section>
            <section class="cv">
                <div class="portrait">
                    <img class="portrait__img img-fluid" src="~/assets/images/portrait.png" alt="portrait" />
                    <p class="portrait__text">Nelly VITALI, éducatrice sportive passionnée, spécialisée en Gymnastique Rythmique depuis 20 ans.</p>
                </div>
                <div class="parcours">
                    <h3 class="cv__titre">MON PARCOURS:</h3>
                    <p class="text-medium">
                        Après avoir travaillé de nombreuses années en milieu associatif, j’ai eu envie de développer mon propre concept.
                        <br />
                        Aujourd’hui je mets mon expérience au service des collectivités mais aussi des particuliers en proposant des séances adaptées aux besoins de chacun, toujours avec pédagogie et bienveillance.
                    </p>
                </div>
                <div class="parcours">
                    <h3 class="cv__titre">REALISATIONS MARQUANTES:</h3>
                    <ul class="list text-medium">
                        <li cv__listItem>
                            2026: Création d’un projet pédagogique 2-6 ans
                            <UL>
                                <Li> Conception d’un programme pédagogique destiné aux enfants de 2 à 6 ans au Liberty Park de Terville.</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            2025: Création artistique pour Gymmotion
                            <UL>
                                <Li>Collaboration avec le comité départemental de gymnastique pour la création de la première partie du spectacle <b>Gymmotion aux Arènes de Metz<:</b>.</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            2024: Création d’un spectacle pour la flamme olympique
                            <UL>
                                <Li>Création d’un spectacle mêlant breakdance et gymnastique à l’occasion du passage de la flamme olympique à Metz.</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            Depuis 2020: Interventions petite enfance
                            <UL>
                                <Li>Interventions auprès de la Communauté de l’Arc Mosellan ainsi que dans de nombreuses crèches en France et au Luxembourg.</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            Depuis 2010: Formatrice pour la Fédération Française de Gymnastique et Campus Format Pro Sport :
                            <UL>
                                <Li class="cv__listItemDescription">-Formation d’éducateurs sportifs.</Li>
                                <Li class="cv__listItemDescription">-Référente petite enfance.</Li>
                                <Li class="cv__listItemDescription">-Accompagnement et tutorat d’apprentis..</Li>
                            </UL>
                        </li>
                    </ul>
                </div>
                <div class="parcours">
                    <h3 class="cv__titre">AUTRES EXP&EacuteRIENCES PROFESSIONNELLES:</h3>
                    <ul class="list text-medium">
                        <li cv__listItem>
                            2018-2023: Responsable technique petite enfance et loisir
                            <UL>
                                <Li >Association Thionvilloise de GRS</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            2010-2023: Formatrice petite enfance, gym sénior et Gymnastique Rythmique
                            <UL>
                                <Li >Fédération Française de Gymnastique et Campus Format Pro Sport</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            2010-2018: Educatrice sportive en Gymnastique Rythmique Association
                            <UL>
                                <Li >Gymnique Fameckoise</Li>
                            </UL>
                        </li>
                        <li cv__listItem>
                            2000-2010: Educatrice sportive en Gymnastique Rythmique, animatrice petite enfance et sénior
                            <UL>
                                <Li >Olympique Gymnase Club Nice</Li>
                                <Li >Association Thionvilloise de Gymnastique Rythmique Thionville</Li>
                                <Li >Association gymnique Fameckoise</Li>
                            </UL>
                        </li>
                    </ul>
                </div>
                <div class="parcours">
                    <h3 class="cv__titre">DIPLÔMES ET FORMATIONS:</h3>
                    <ul class="list text-medium">
                        <li cv__listItem>Brevet d’état d’éducatrice sportive, activités gymniques (option gymnastique rythmique)</li>
                        <li cv__listItem>Psychologie de l’enfant de 0 à 6 ans</li>
                        <li cv__listItem>Animateur baby gym, sénior et sport santé</li>
                        <li cv__listItem>Certification aux compétences de maître d’apprentissage</li>
                        <li cv__listItem>Gestion du temps et organisation</li>
                    </ul>
                </div>
            </section>
         </div>
        <div class="clickableLogoAbout">
            @await Html.PartialAsync("_ClickableLogoPartial")
        </div>
        <div class="socialNetworksandContact socialNetworksandContact__about">
            @await Html.PartialAsync("_SocialNetworks&ContactPartial")
        </div>

        <img class="mx-auto d-block pointer arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />

    </div>
</div>
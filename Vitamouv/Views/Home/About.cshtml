@{
    ViewData["Title"] = "A propos";
}

<div >
    <div class="mb-5 d-flex justify-content-center m-lg-5">
        <section class="presentation container-fluid text-center">
            <div class="presentation__background">
                <img class="presentation__img img-fluid" src="~/assets/images/portrait.png" alt="portrait" />
                <p class="presentation__text container-fluid">
                    Je m’appelle Nelly VITALI et je suis éducatrice sportive spécialisée en Gymnastique rythmique depuis 20 ans.
                    <br />
                     Après avoir travaillé de nombreuses années en milieu associatif, j’ai eu envie de développer mon propre concept.
                    <br />
                     Aujourd’hui je mets mon expérience au service des collectivités mais aussi des particuliers en proposant des séances adaptées aux besoins de chacun, toujours avec pédagogie et bienveillance.
                </p>
            </div>
        </section>
    </div>
    <section class="cv">
        <h3 class="cv__titre">DIPLÔMES ET FORMATIONS:</h3>
        <ul class="list">
            <li cv__listItem>Brevet d’état d’éducatrice sportive, activités gymniques (option gymnastique rythmique)</li>
            <li cv__listItem>Psychologie de l’enfant de 0 à 6 ans</li>
            <li cv__listItem>Animateur baby gym, sénior et sport santé</li>
            <li cv__listItem>Certification aux compétences de maître d’aprentissage</li>
            <li cv__listItem>Gestion du temps et organisation</li>
        </ul>
    </section>
    <div class="clickableLogoAbout">
        @await Html.PartialAsync("_ClickableLogoPartial")
    </div>
</div>
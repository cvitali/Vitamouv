@{
    ViewData["Title"] = "Vita'MOUV: Le sport qui vient à vous !";
    ViewData["Description"] = "Professeur de gym en Moselle (57). Vita'MOUV, c'est le sport qui vient à vous ! Découvrez mes prestations de gym douce, gym rythmique, baby gym, anniversaires, ouvertures de bals, danse et création d'événements sportifs pour tous les âges et tous les niveaux. Interventions clés en main pour événements privés, crèches, écoles, collectivités, EHPAD, résidences seniors et structures médico sociales en Moselle (57) et au Luxembourg.";
}

<div class="main__home text-center">
    
    <h1 class="home__title">Bienvenue chez Vita'MOUV !</h1>
    <h2 class="home__subtitle">Cours de gym, spectacles et animations pour collectivités et particuliers</h2>
    
    <div class="hero container text-center">
        <div class="hero__links row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2 g-sm-3 g-md-5 justify-content-center">
                <a class="hero__link col" href="../Prestations/Mini'MOUV"><img class="hero__linkImg" src="~/assets/images/home_mini.png"/></a>               
                <a class="hero__link col" href="../Prestations/Animat'MOUV"><img class="hero__linkImg" src="~/assets/images/home_animat.png"></a>     
                <a class="hero__link col" href="../Prestations/Dance'MOUV"><img class="hero__linkImg" src="~/assets/images/home_danse.png"></a>            
                <a class="hero__link col" href="../Prestations/Slow'MOUV"><img class="hero__linkImg" src="~/assets/images/home_slow.png"></a>
                <a class="hero__link col" href="../Prestations/Event'MOUV"><img class="hero__linkImg" src="~/assets/images/home_event.png"></a>
                <a class="hero__link col" href="../Prestations/School'MOUV"><img class="hero__linkImg" src="~/assets/images/home_school.png"></a>
        </div>
        <br />
        <p class="hero__text">
            
        <p>
            <br />
            Depuis sa création en Janvier 2023, <b>Vita’MOUV</b> a développé de nombreux parteneriats et je travaille aujourd'hui avec pas moins d’une quarantaine de structures en France et au Luxembourg: crèches, associations, communautés de communes, foyers, périscolaires, etc...
            <br />
        </p>
   <h4 class="homePunchline"> Alors, n’attendez plus: vous aussi rejoignez le mouvement, laissez le sport venir à vous ! </h4>
        </div>
    <div class="clickableLogoHome">
        @await Html.PartialAsync("_ClickableLogoPartial3")
    </div>
   
    <div class="socialNetworksandContact socialNetworksandContact__Home">
        @await Html.PartialAsync("_SocialNetworks&ContactPartial")
        <div class="contact">
            <h5 class="mb-3">ou contactez-moi directement:</h5>
            <div class="btn btn__contactHome btn-outline-burgundy js-contactBtn">
                Prendre contact
            </div>
        </div>
    </div>
    <img class="arrow-up-js" src="~/assets/icones/icons8-flèche-haut-64.png" alt="retourner en haut de page" />
</div>

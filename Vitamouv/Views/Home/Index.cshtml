@{
    ViewData["Title"] = "Home Page";
}



<div class="text-center">
    <h1 class="display-4">Bienvenue chez <strong>Vita'MOUV</strong>!</h1>
    <div class="presentation">
        <p class="presentation__text">
        Je suis Nelly Vitali, éducatrice sportive passionnée, créatrice d’expériences de bien-être et de mouvement, et fondatrice de Vita’MOUV.
        <br />
        Depuis toujours, le mouvement, la danse et le sport sont au cœur de ma vie.              
        Animée par une passion profonde pour l’activité physique, j’ai consacré de nombreuses années à l’enseignement, à l’accompagnement et à la transmission auprès de publics de tous âges en m’appuyant sur mes expériences et mes formations. 
        Créative, dynamique et à l’écoute, j’ai imaginé Vita’MOUV pour proposer des activités physiques pour tous les publics, à chaque étape ou événement de la vie.
        <p>
    </div>
    <div class="importedClickableLogo">
        @await Html.PartialAsync("_clickableLogo");
    </div>
</div>
